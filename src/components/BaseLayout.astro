---
import { Font } from 'astro:assets';
import Header from './Header.astro';
import Contact from './Contact.astro';
import { site } from '../site';
import '../styles/tokens.css';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; noindex?: boolean }
// Imagen para compartir (1200×630, aprobada por Zabrinna el 17 de octubre de 2026), relativa a la base.
// No usar las imágenes provisionales (IA o stock).
const defaultImage: string | undefined = 'images/compartir.jpg';
const defaultImageAlt = `${site.name}, ${site.discipline}: retrato sobre fondo azul marino con su nombre.`;
const { title, description = site.description, image = defaultImage, imageAlt = defaultImageAlt, noindex = false } = Astro.props;
// Portada: «Zabrinna Vargas · Digital Marketing Manager»; resto: «Página · Zabrinna Vargas».
const fullTitle = title ? `${title} · ${site.shortName}` : `${site.shortName} · ${site.discipline}`;
const pathname = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1');
const canonical = new URL(pathname, Astro.site).href;
const imageUrl = image && new URL(image, new URL(import.meta.env.BASE_URL, Astro.site)).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-playfair" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-lato" preload />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    {imageUrl && image === defaultImage && <meta property="og:image:width" content="1200" />}
    {imageUrl && image === defaultImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <footer>
      <Contact />
    </footer>
  </body>
</html>
