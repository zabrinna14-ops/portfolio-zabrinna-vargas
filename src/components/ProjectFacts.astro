---
import type { Project } from '../projects';
import Metric from './Metric.astro';
interface Props { project: Project }
const { project: { data } } = Astro.props;
---
<aside class="project-facts split-aside" aria-label="Ficha del proyecto">
  <span class="facts-glass" aria-hidden="true"></span>
  <dl>
    <div><dt>Proyecto</dt><dd>{data.name}</dd></div>
    <div><dt>Mi papel</dt><dd>{data.role}</dd></div>
    {data.period && <div><dt>Periodo</dt><dd>{data.period}</dd></div>}
    <div><dt>Áreas</dt><dd>{data.scope}</dd></div>
  </dl>
  <Metric {...data.highlight} variant="fact" />
</aside>
