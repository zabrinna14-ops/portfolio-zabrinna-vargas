---
import type { Project } from '../projects';
import Metric from './Metric.astro';
interface Props { results: NonNullable<Project['data']['results']> }
const { results } = Astro.props;
---
<section class="impact">
  <div class="impact-inner">
    <h2>Resultados</h2>
    {results.metric && <Metric {...results.metric} variant="result" />}
    <div class="impact-copy">{results.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
  </div>
</section>
