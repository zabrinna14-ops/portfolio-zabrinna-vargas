---
interface Props { value: string; label: string; variant?: 'card' | 'fact' | 'result' }
const { value, label, variant = 'card' } = Astro.props;
---
{variant === 'card' ? (
  <p class="card-result"><strong>{value}</strong><span>{label}</span></p>
) : variant === 'fact' ? (
  <p class="fact-highlight">{value}<span>{label}</span></p>
) : (
  <div class="result-number">{value}<span>{label}</span></div>
)}
