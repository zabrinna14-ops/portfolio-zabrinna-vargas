---
import { homeUrl, site } from '../site';
---
<header class="site-header">
  <a class="brand" href={homeUrl}>{site.name}<span>{site.discipline}</span></a>
  <button class="menu-toggle" type="button" popovertarget="menu-principal" aria-label="Menú"><span aria-hidden="true"></span></button>
  <nav id="menu-principal" popover aria-label="Navegación principal">
    <a href={`${homeUrl}#proyectos`}>Proyectos</a>
    <a href={`${homeUrl}#sobre-mi`}>Sobre mí</a>
    <a href={`${homeUrl}#contacto`}>Contacto</a>
  </nav>
</header>
